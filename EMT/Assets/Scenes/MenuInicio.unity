  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab29bcac2c1063d43ae87c7c899d19e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoManager
  parrafos:
  - "Una amena\xE7a ha enva\xEFt els carrers de Val\xE8ncia i ha pres la forma de
    terribles monstres que embruten tot al seu pas. Ning\xFA pot detindre'ls\u2026
    excepte tu, perqu\xE8\u2026 ets Superb\xFAs, el superheroi de EMT!"
  - "La teua missi\xF3 ser\xE0 rec\xF3rrer les diferents zones afectades, enfrontar-te
    a les criatures contaminants i tornar Val\xE8ncia a un entorn net i lliure d'emissions."
  - "Per a superar cada nivell haur\xE0s de derrotar tots els monstres que trobes.
    Com m\xE9s n'elimines, major ser\xE0 la teua contribuci\xF3 per a recuperar un
    aire m\xE9s net."
  - "Prepara't per a l'acci\xF3 i ajuda Superb\xFAs a v\xE9ncer la contaminaci\xF3!"
  textoDialogo: {fileID: 375919342}
  velocidadEscritura: 0.05
  inputContinuar: {fileID: -2420250321053110607, guid: f44461c906eda554da4bd88160af2524, type: 3}
  textoEnter: {fileID: 1434225437}
  velocidadParpadeo: 0.5
